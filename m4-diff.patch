+  <script>
+    var m4Correct = { q1: false, q2: false };
+
+    function goM4(page) {
+      document.querySelectorAll('.m4-page').forEach(el => el.classList.remove('active'));
+      document.getElementById('m4p' + page).classList.add('active');
+      window.scrollTo({ top: 0, behavior: "smooth" });
+      try { localStorage.setItem("p101_m4_page", page); } catch(e) {}
+    }
+
+    function tryGoM4Recap() {
+      if (m4Correct.q1 && m4Correct.q2) {
+        goM4(6);
+      } else {
+        showM4Toast(false, 'Answer Both Questions First', 'You must answer both questions correctly to unlock the Recap.');
+      }
+    }
+
+    document.addEventListener("DOMContentLoaded", function() {
+      try {
+        var p = localStorage.getItem("p101_m4_page");
+        if (p && p !== '6') {
+          document.querySelectorAll('.m4-page').forEach(el => el.classList.remove('active'));
+          var el = document.getElementById('m4p' + p);
+          if (el) el.classList.add('active');
+        }
+      } catch(e) {}
+    });
+
+    function checkM4(qClass, isCorrect, el) {
+      if (isCorrect) {
+        m4Correct[qClass] = true;
+        document.querySelectorAll('.' + qClass).forEach(btn => {
+          btn.classList.remove('selected', 'wrong-opt');
+        });
+        el.classList.add('selected');
+        
+        if (m4Correct.q1 && m4Correct.q2) {
+          showM4Toast(true, 'Great Job!', 'You got both questions right! You can now move to the recap.');
+        } else {
+          showM4Toast(true, 'Correct!', 'Good job, keep going.');
+        }
+      } else {
+        document.querySelectorAll('.' + qClass).forEach(btn => {
+          btn.classList.remove('selected', 'wrong-opt');
+        });
+        el.classList.add('wrong-opt');
+        showM4Toast(false, 'Not Quite', 'That is incorrect. Try again!');
+        m4Correct[qClass] = false;
+      }
+    }
+
+    function showM4Toast(isSuccess, title, msg) {
