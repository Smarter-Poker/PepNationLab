{
  "name": "pepnationlab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/ci/checkout-diluent-guard.mjs && node scripts/ci/payment-confirmation-guard.mjs && node scripts/ci/pricing-integrity-guard.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "echo 'Skipping lint on Vercel' && exit 0",
    "test": "vitest run --exclude __tests__/db --exclude __tests__/e2e",
    "test:db": "vitest run __tests__/db",
    "test:e2e": "playwright test",
    "postinstall": "patch-package",
    "prepare": "git config core.hooksPath .husky 2>/dev/null || true"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.1.0",
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^13.2.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "livekit-client": "^2.22.2",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^1.41.0",
    "mermaid": "^11.17.2",
    "next": "16.3.4",
    "patch-package": "^8.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "web-push": "^3.6.7",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "ts-morph": "^28.0.0",
    "typescript": "^7",
    "vitest": "^5.0.0"
  }
}
