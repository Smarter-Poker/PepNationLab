# ============================================================================
# PepNationRX Backend - Environment Template
# Copy to .env and fill in real values. Never commit the populated .env file.
# Secrets in production are sourced from AWS Secrets Manager, not this file.
# ============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL ---
# Either provide DATABASE_URL or the discrete PG* values below.
DATABASE_URL=postgres://pepnationrx:password@localhost:5432/pepnationrx
PGHOST=localhost
PGPORT=5432
PGDATABASE=pepnationrx
PGUSER=pepnationrx
PGPASSWORD=password
# Set to true when connecting to managed RDS with TLS.
PGSSL=false
PG_POOL_MAX=10

# --- JWT ---
# Use long, random, distinct strings. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-random-access-secret
JWT_REFRESH_SECRET=replace-with-random-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=pepnationrx

# --- Password Hashing ---
BCRYPT_ROUNDS=12

# --- PHI Encryption (KMS envelope) ---
# In production this is a KMS-managed data key. For local development a
# 32-byte hex value is accepted. Generate with: openssl rand -hex 32
PHI_ENCRYPTION_KEY=replace-with-32-byte-hex-key

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
