#!/bin/sh
set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
bash scripts/guard-shared-clone.sh push
if ! git diff --quiet HEAD --; then
  echo 'Permission qualification requires the committed candidate and clean tracked files.' >&2
  exit 1
fi
node --test tests/*.test.mjs tests/*.test.cjs scripts/ci/test-message-reaction-access.mjs scripts/ci/test-order-item-cost-access.mjs
node scripts/ci/check-explicit-table-access.mjs
node scripts/check_rls_policies.js
node scripts/check_migration_column_drift.js
if git diff --name-only origin/main...HEAD -- supabase/migrations scripts/ci tests/fixtures .github/workflows/deploy-migrations.yml | grep -q .; then
  python3 scripts/ci/test-browser-structural-privileges.py
  python3 scripts/ci/test-message-reaction-access.py
  python3 scripts/ci/test-order-item-cost-access.py
  for access_test in scripts/ci/test-explicit-*-access.py; do
    python3 "$access_test"
  done
fi
